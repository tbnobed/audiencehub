APP_ENV=production
PUBLIC_BASE_URL=https://audience.example.org
POSTGRES_USER=audience
POSTGRES_PASSWORD=replace-on-host
DATABASE_URL=postgresql+psycopg://audience:replace-on-host@db:5432/audience_hub
SECRET_KEY=generate-with-openssl-rand-hex-32
FERNET_KEY=generate-with-python-cryptography-Fernet.generate_key
PII_HASH_PEPPER=generate-with-openssl-rand-hex-32
AUTH_MODE=oidc
OIDC_ISSUER=https://sso.example.org/application/o/audience-hub/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ROLE_CLAIM=groups
OIDC_ADMIN_GROUPS=ah-admins
OIDC_ANALYST_GROUPS=ah-analysts
OIDC_VIEWER_GROUPS=ah-viewers
INGEST_CORS_ORIGINS=
DEFAULT_PHONE_REGION=US
GMAIL_STYLE_DOMAINS=gmail.com,googlemail.com
UPLOAD_DIR=/data/uploads
UPLOAD_RETENTION_DAYS=7
EXPORT_DIR=/data/exports
EVENT_RETENTION_DAYS=730
EXPORT_RETENTION_DAYS=14
WORKER_CONCURRENCY=4
API_WORKERS=4
API_BIND_HOST=127.0.0.1
API_PORT=8080
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=02
DELETION_TWO_PERSON=true
LOG_LEVEL=INFO